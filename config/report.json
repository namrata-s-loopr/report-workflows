{
  "title": "Weekly report",
  "emailApi": {
    "payload": {
      "to": "{{recipients}}",
      "subject": "{{subject}}",
      "html": "{{html}}",
      "text": "{{text}}"
    }
  },
  "errorReport": {
    "minimumOccurrences": 10,
    "occurrenceField": "occurrences"
  },
  "queries": {
    "tenant_checks": {
      "refId": "A",
      "source": "uptime-kuma",
      "dashboardUrl": "http://monitor.on.loopr.ai/dashboard/36",
      "fields": {
        "tenant": "Tenant Name",
        "sanity_check": "Sanity Check",
        "kuma_and_elk": "Kuma and ELK"
      }
    },
    "instances": {
      "refId": "B",
      "source": "prometheus-instances",
      "datasource": { "uid": "grafanacloud-prom" },
      "cpuExpr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"integrations/node_exporter\",mode=\"idle\"}[5m])))",
      "diskExpr": "max by (instance) (100 * (1 - node_filesystem_avail_bytes{job=\"integrations/node_exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"integrations/node_exporter\",mountpoint=\"/\"}))",
      "fields": {
        "instance": "Instance",
        "cpu": "CPU %",
        "disk": "Disk %"
      }
    },
    "errors": {
      "refId": "C",
      "source": "loki-errors",
      "datasource": { "uid": "grafanacloud-logs" },
      "expr": "sum by (instance, error_message, error_code) (count_over_time({job=\"integrations/docker\",level=\"ERROR\"} | json error_message=\"message\", error_code=\"error.code\" | __error__=\"\" | error_message!=\"\" [7d]))",
      "fields": {
        "unique_error": "Unique error",
        "instances": "Instances",
        "occurrences": "Occurrences"
      }
    }
  }
}
